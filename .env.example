from pydantic_settings import BaseSettings, SettingsConfigDict

class Settings(BaseSettings):
    model_config = SettingsConfigDict(env_file=".env")
    llm_api_key: str = ""
    llm_model: str = ""

settings = Settings()


# Which provider the API server uses: gemini, anthropic or openai
LLM_PROVIDER=gemini
# Exact model name from the provider's docs
LLM_MODEL=gemini-3.5-flash-lite
# API key for the provider above
LLM_API_KEY=your_key_here

# Only needed if you run benchmark.py against other providers (optional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Protection for a public deployment
RATE_LIMIT_PER_MINUTE=10
MAX_ANALYSES_PER_DAY=200